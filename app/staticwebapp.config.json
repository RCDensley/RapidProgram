{
  "routes": [
    {
      "route": "/api/activity",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/checkin",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/github",
      "statusCode": 302
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*", "/*.{css,js,png,jpg,svg,ico,json,woff,woff2,ttf}"]
  }
}
